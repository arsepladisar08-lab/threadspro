# ==============================================================================
# AutoThreads Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Prefixed with VITE_, Safe for Browser Bundle)
# ------------------------------------------------------------------------------
# Mode AI: "direct" untuk preview di Google AI Studio (browser langsung panggil Gemini)
#          "proxy" untuk produksi Vercel (browser panggil /api/ai demi keamanan API key)
VITE_AI_MODE="direct"

# Adapter Penyimpanan: "local" (IndexedDB via idb-keyval, tanpa backend)
#                      "supabase" (Tabel PostgreSQL + RLS untuk multi-device)
VITE_STORAGE="local"

# Konfigurasi Supabase (Hanya jika VITE_STORAGE="supabase")
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Bucket publik untuk lampiran gambar/video (lihat docs/supabase-media-bucket.sql)
VITE_SUPABASE_MEDIA_BUCKET="autothreads-media"

# Flag Simulasi Mock Threads API (default false untuk akun Threads asli)
VITE_THREADS_MOCK="false"

# Suppress Vite native config warning
VITE_CONFIG_NATIVE_IGNORE_WARNING="true"


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Vercel Functions / Node Runtime - NEVER IN BUNDLE)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Otomatis disediakan oleh AI Studio Secrets)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Kunci Layanan Supabase (Hanya untuk Vercel Functions saat sync data token)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Kredensial Resmi Meta Threads App (Untuk Fase 1 OAuth Akun Sendiri)
THREADS_APP_ID="your_threads_app_id"
THREADS_APP_SECRET="your_threads_app_secret"
THREADS_REDIRECT_URI="https://your-domain.vercel.app/api/threads/callback"
THREADS_GRAPH_BASE="https://graph.threads.net"
THREADS_AUTH_BASE="https://threads.net"

# Kunci Enkripsi Token AES-256-GCM (32 bytes hex)
TOKEN_ENC_KEY="your_32_byte_hex_encryption_key_here"

# Fitur Flag Tambahan Meta Threads
FEATURE_KEYWORD_SEARCH="false"
FEATURE_PUBLISHING="true"

# Secret untuk Mengamankan Vercel Cron Daily Job
CRON_SECRET="your_secure_cron_secret"
