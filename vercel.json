{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "*/15 * * * *"
    }
  ]
}
